# Gemini API key. Either name works - app.py harmonizes them into a single
# GEMINI_API_KEY at startup and removes the alias to avoid SDK warnings.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional: override the default Gemini model (gemini-2.5-flash).
# GEMINI_MODEL=gemini-1.5-flash

# Optional: Hugging Face token, only needed if SamLowe/roberta-base-go_emotions
# or openai/whisper-tiny.en require authenticated access in your environment.
# HF_TOKEN=

# Optional: point speech_to_text.py at a different Whisper checkpoint.
# MM_STT_MODEL=openai/whisper-tiny.en

# Optional: override the local fine-tuned Wav2Vec2 acoustic model directory.
# Defaults to speech_engine/models/ravdess_wav2vec2_finetuned/best
# MM_ACOUSTIC_MODEL_DIR=./speech_engine/models/ravdess_wav2vec2_finetuned/best

# Optional: load the acoustic model from the Hugging Face Hub instead of a
# local directory (takes priority over MM_ACOUSTIC_MODEL_DIR when set).
# HUGGINGFACE_MODEL_ID=Dhruv-jain/Mannmitra_Speech-model
