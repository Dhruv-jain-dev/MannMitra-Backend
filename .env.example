# Supabase PostgreSQL connection string (Project Settings > Database > Connection string).
# Do not commit a real password or key.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

MANNMITRA_ENV=development
MANNMITRA_AUTH_JWT_SECRET=replace-with-a-local-development-secret

# Supabase Auth verification. Keep service-role and JWT secrets server-side.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ANON_KEY=server-side-only-if-required
SUPABASE_SERVICE_ROLE_KEY=server-side-only
# Only configure this for a project explicitly using legacy HS256 signing.
SUPABASE_JWT_SECRET=server-side-only-if-required

# Disabled by default. Configure only for the owner-approved first-admin run.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_TARGET_ID=approved-supabase-auth-uuid
GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=75000
HF_TOKEN=your-huggingface-token
